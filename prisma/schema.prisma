generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  firstName String
  lastName  String
  username  String      @unique
  email     String      @unique
  password  String
  latitude  Float?
  longitude Float?
  sports    SportUser[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Sport {
  id       String    @id @default(uuid())
  name     String
  level    Level     @relation(fields: [levelId], references: [id])
  levelId  String
  users    SportUser[]
}

model Level {
  id      String    @id @default(uuid())
  name    String
  sports  Sport[]   // A level can have many sports
}

model SportUser {
  id       String  @id @default(uuid())
  user     User    @relation(fields: [userId], references: [id])
  userId   String
  sport    Sport   @relation(fields: [sportId], references: [id])
  sportId  String
}